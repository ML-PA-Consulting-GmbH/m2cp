// Private m2cp SDK — librelease's default export() reads this directive,
// copies the SDK into the bundle as ./m2cp-sdk, and rewrites the path there.
// The require pairs with the replace so direct `go build` (GOWORK=off) is
// happy without a workspace.
require m2cp v0.0.0

replace m2cp => ./m2cp-sdk
